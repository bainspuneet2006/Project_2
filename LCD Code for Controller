
// NOTE: CHANGE THE PINS 
#define LCD_RS (1<<1)  // PB1
#define LCD_E  (1<<2)  // PB2
#define LCD_D4 (1<<3)  // PB3
#define LCD_D5 (1<<4)  // PB4
#define LCD_D6 (1<<5)  // PB5
#define LCD_D7 (1<<6)  // PB6

int battery_percent = 84;

// ADD THIS at the end of GPIO_Init()
GPIOB->MODER &= ~(0xFFF << 2);   // clear PB1–PB6
GPIOB->MODER |=  (0x555 << 2);   // set as output

// ADD THIS TO MAIN
LCD_init();

// UPDATE WHILE LOOP IN MAIN:
while (1)
{
	read_path_control();
	read_joystick();
	assign_command();

	LCD_update();   // 🔥 NEW

	printf("X=%d Y=%d BTN=%d CMD=%d\r\n", joy_x, joy_y, press, cmd);

	send_command(cmd);

	delayms(100);
}

void LCD_pulse(void)
{
	GPIOB->ODR |= LCD_E;
	delayms(1);
	GPIOB->ODR &= ~LCD_E;
}

void LCD_send_nibble(unsigned char nib)
{
	GPIOB->ODR &= ~(LCD_D4 | LCD_D5 | LCD_D6 | LCD_D7);

	if(nib & 1) GPIOB->ODR |= LCD_D4;
	if(nib & 2) GPIOB->ODR |= LCD_D5;
	if(nib & 4) GPIOB->ODR |= LCD_D6;
	if(nib & 8) GPIOB->ODR |= LCD_D7;

	LCD_pulse();
}

void LCD_byte(unsigned char data, int rs)
{
	if(rs) GPIOB->ODR |= LCD_RS;
	else   GPIOB->ODR &= ~LCD_RS;

	LCD_send_nibble(data >> 4);
	LCD_send_nibble(data & 0x0F);

	delayms(2);
}

void LCD_cmd(unsigned char cmd)
{
	LCD_byte(cmd, 0);
}

void LCD_char(char c)
{
	LCD_byte(c, 1);
}

void LCD_print(char *str)
{
	while(*str) LCD_char(*str++);
}

void LCD_init(void)
{
	delayms(20);

	LCD_send_nibble(0x03);
	delayms(5);
	LCD_send_nibble(0x03);
	delayms(5);
	LCD_send_nibble(0x03);
	delayms(5);
	LCD_send_nibble(0x02);

	LCD_cmd(0x28); // 4-bit, 2 line
	LCD_cmd(0x0C); // display ON
	LCD_cmd(0x06);
	LCD_cmd(0x01);

	delayms(5);
}

void LCD_print_int(int val)
{
	char buf[5];
	sprintf(buf, "%d", val);
	LCD_print(buf);
}

int is_auto_mode(void)
{
	return (cmd == PATH1 || cmd == PATH2 || cmd == PATH3);
}

void LCD_update(void)
{
	LCD_cmd(0x80);

	if(is_auto_mode())
		LCD_print("Mode: AUTO   ");
	else
		LCD_print("Mode: MANUAL ");

	LCD_cmd(0xC0);

	if(is_auto_mode())
	{
		char next = get_next_move();

		LCD_print("Next:");
		LCD_print(move_to_string(next));

		// move cursor near end (col ~12)
		LCD_cmd(0xC0 + 11);

		LCD_print_int(battery_percent);
		LCD_print("%");
	}
	else
	{
		LCD_print("Bat: ");
		LCD_print_int(battery_percent);
		LCD_print("%     ");
	}
}












