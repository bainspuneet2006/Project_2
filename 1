#define SYSCLK 72000000L
#define BAUDRATE 115200L
#define RELOAD_10MS (0x10000L-(SYSCLK/(12L*100L)))
#define SARCLK 18000000L
#define SMB_FREQUENCY 400000L

char _c51_external_startup (void)
{
    SFRPAGE = 0x00;
    WDTCN = 0xDE;
    WDTCN = 0xAD;

    VDM0CN |= 0x80;
    RSTSRC = 0x02;

#if (SYSCLK == 48000000L)
    SFRPAGE = 0x10;
    PFE0CN  = 0x10;
    SFRPAGE = 0x00;
#elif (SYSCLK == 72000000L)
    SFRPAGE = 0x10;
    PFE0CN  = 0x20;
    SFRPAGE = 0x00;
#endif

#if (SYSCLK == 12250000L)
    CLKSEL = 0x10;
    CLKSEL = 0x10;
    while ((CLKSEL & 0x80) == 0);
#elif (SYSCLK == 24500000L)
    CLKSEL = 0x00;
    CLKSEL = 0x00;
    while ((CLKSEL & 0x80) == 0);
#elif (SYSCLK == 48000000L)
    CLKSEL = 0x00;
    CLKSEL = 0x00;
    while ((CLKSEL & 0x80) == 0);
    CLKSEL = 0x07;
    CLKSEL = 0x07;
    while ((CLKSEL & 0x80) == 0);
#elif (SYSCLK == 72000000L)
    CLKSEL = 0x00;
    CLKSEL = 0x00;
    while ((CLKSEL & 0x80) == 0);
    CLKSEL = 0x03;
    CLKSEL = 0x03;
    while ((CLKSEL & 0x80) == 0);
#else
#error SYSCLK must be either 12250000L, 24500000L, 48000000L, or 72000000L
#endif

    // Inputs
    P1MDOUT &= ~(0b_0000_0001);
    P3MDOUT &= ~(0b_0000_0001); // IR pin input

    // Outputs
    P2MDOUT |= 0b_0000_1111;
    P1MDOUT |= 0b_0001_1000;

    // UART
    P0MDOUT |= 0x10;
    XBR0 = 0x05;
    XBR1 = 0x10;
    XBR2 = 0x40;

    SCON0 = 0x10;
    CKCON0 |= 0b_0000_0000;
    TH1 = 0x100 - ((SYSCLK/BAUDRATE)/(2L*12L));
    TL1 = TH1;
    TMOD &= ~0xf0;
    TMOD |= 0x20;
    TR1 = 1;
    TI = 1;

    // Timer5 PWM interrupt
    SFRPAGE = 0x10;
    TMR5CN0 = 0x00;
    pwm_reload = 0x10000L - (SYSCLK/(12L*50000L));
    TMR5RL = pwm_reload;
    TMR5 = 0xffff;
    EIE2 |= 0b_0000_1000;
    TR5 = 1;

    SFRPAGE = 0x00;
    // Configure Timer 0 as I2C clock source
    CKCON0 |= 0b_0000_0100;
    TMOD &= 0xf0;
    TMOD |= 0x02;
    TL0 = TH0 = 256-(SYSCLK/SMB_FREQUENCY/3);
    TR0 = 1;

    // Configure and enable SMBus
    SMB0CF = 0b_0101_1100;
    SMB0CF |= 0b_1000_0000;

    EA = 1;
    SFRPAGE = 0x00;

    return 0;
}

volatile unsigned char pwm_count;
volatile unsigned char move_state;
volatile unsigned char pwm_threshold;

void Timer5_ISR (void) interrupt INTERRUPT_TIMER5
{
    SFRPAGE = 0x10;
    TF5H = 0;

    if (move_state > 0)
    {
        pwm_count++;

        if (pwm_count > 50)
        {
            pwm_count = 0;
        }

        if (move_state == 2) // pivot left
        {
            if (left_pwm_threshold > pwm_count)
            {
                Hbridge_1_1 = 0;
                Hbridge_1_2 = 1;
            }
            else
            {
                Hbridge_1_1 = 0;
                Hbridge_1_2 = 0;
            }

            if (right_pwm_threshold > pwm_count)
            {
                Hbridge_2_1 = 1;
                Hbridge_2_2 = 0;
            }
            else
            {
                Hbridge_2_1 = 0;
                Hbridge_2_2 = 0;
            }
        }
        else if (move_state == 3) // pivot right
        {
            if (left_pwm_threshold > pwm_count)
            {
                Hbridge_1_1 = 1;
                Hbridge_1_2 = 0;
            }
            else
            {
                Hbridge_1_1 = 0;
                Hbridge_1_2 = 0;
            }

            if (right_pwm_threshold > pwm_count)
            {
                Hbridge_2_1 = 0;
                Hbridge_2_2 = 1;
            }
            else
            {
                Hbridge_2_1 = 0;
                Hbridge_2_2 = 0;
            }
        }
        else if (move_state == 7)
        {
            if (left_pwm_threshold > pwm_count)
            {
                Hbridge_1_1 = 0;
                Hbridge_1_2 = 1;
            }
            else
            {
                Hbridge_1_1 = 0;
                Hbridge_1_2 = 0;
            }

            if (right_pwm_threshold > pwm_count)
            {
                Hbridge_2_1 = 0;
                Hbridge_2_2 = 1;
            }
            else
            {
                Hbridge_2_1 = 0;
                Hbridge_2_2 = 0;
            }

        }
        else if (move_state < 6) // forward family
        {
            if (left_pwm_threshold > pwm_count)
            {
                Hbridge_1_1 = 0;
                Hbridge_1_2 = 1;
            }
            else
            {
                Hbridge_1_1 = 0;
                Hbridge_1_2 = 0;
            }

            if (right_pwm_threshold > pwm_count)
            {
                Hbridge_2_1 = 0;
                Hbridge_2_2 = 1;
            }
            else
            {
                Hbridge_2_1 = 0;
                Hbridge_2_2 = 0;
            }
        }
        else // backward family
        {
            if (left_pwm_threshold > pwm_count)
            {
                Hbridge_1_1 = 1;
                Hbridge_1_2 = 0;
            }
            else
            {
                Hbridge_1_1 = 0;
                Hbridge_1_2 = 0;
            }

            if (right_pwm_threshold > pwm_count)
            {
                Hbridge_2_1 = 1;
                Hbridge_2_2 = 0;
            }
            else
            {
                Hbridge_2_1 = 0;
                Hbridge_2_2 = 0;
            }
        }
    }
    else
    {
        Hbridge_1_1 = 0;
        Hbridge_1_2 = 0;
        Hbridge_2_1 = 0;
        Hbridge_2_2 = 0;
    }
}

void Timer3us_Init(void)
{
    SFRPAGE = 0x00;

    CKCON0 &= ~(0b_0100_0000);   // Timer3 uses SYSCLK/12
    TMR3CN0 = 0x00;              // stop Timer3, clear flags
    TMR3RL = 0xE890;             // 1 ms overflow for 72 MHz / 12
    TMR3   = 0xE890;
}

void Timer4ms_Init(void)
{
    SFRPAGE = 0x10;
    TMR4CN0 = 0x00;              // stop Timer4, clear flags
    CKCON1 &= ~(0b_0000_0100);   // Timer4 uses SYSCLK/12 (bit 2 of CKCON1)
    TMR4RL = 0xE890;             // 1ms overflow at 72MHz/12
    TMR4   = 0xE890;
    SFRPAGE = 0x00;
}

void waitms(unsigned int ms)
{
    unsigned int i;
    for(i = 0; i < ms; i++)
    {
        SFRPAGE = 0x10;
        TMR4CN0 &= ~(0x80);            // clear overflow flag
        TMR4 = TMR4RL;                 // reload
        TMR4CN0 |= 0x04;               // start Timer4
        while((TMR4CN0 & 0x80) == 0);  // wait for overflow
        TMR4CN0 &= ~(0x04);            // stop Timer4
        SFRPAGE = 0x00;
    }
}

void movement_fsm(void)
{
    if (move_state == 1)
    {
        left_pwm_threshold = base_speed;
        right_pwm_threshold = base_speed;
        right_blinker = 0;
        left_blinker = 0;
    }
    else if (move_state == 2)
    {
        left_pwm_threshold = base_speed;
        right_pwm_threshold = base_speed;
        left_blinker = 1;
        right_blinker = 0;
    }
    else if (move_state == 3)
    {
        left_pwm_threshold = base_speed;
        right_pwm_threshold = base_speed;
        left_blinker = 0;
        right_blinker = 1;
    }
    else if (move_state == 4)
    {
        left_pwm_threshold = base_speed;
        right_pwm_threshold = slow_speed;
        left_blinker = 0;
        right_blinker = 1;
    }
    else if (move_state == 5)
    {
        left_pwm_threshold = slow_speed;
        right_pwm_threshold = base_speed;
        left_blinker = 1;
        right_blinker = 0;
    }
    else if (move_state == 6)
    {
        left_pwm_threshold = base_speed;
        right_pwm_threshold = base_speed;
        left_blinker = 1;
        right_blinker = 1;
    }
    else if (move_state == 7)
    {
        left_blinker = 0;
        right_blinker = 0;
    }
    else
    {
        left_pwm_threshold = 0;
        right_pwm_threshold = 0;
        right_blinker = 0;
        left_blinker = 0;
    }
}

void controller_mode(unsigned char hex_data)
{
    switch (hex_data)
    {
        case 0x01: move_state = 0; break;
        case 0x02: move_state = 1; break;
        case 0x03: move_state = 6; break;
        case 0x04: move_state = 3; break;
        case 0x05: move_state = 2; break;
        case 0x06: move_state = 2; break;
        case 0x07: move_state = 4; break;
        case 0x08: move_state = 5; break;
        case 0x09: move_state = 6; break;
        case 0x0A: move_state = 6; break;
        case 0x0E: move_state = 7; break;
        default: return;
    }
    movement_fsm();

    if(hex_data == 0x06)
    {
        waitms(1500);
    }
}

void InitADC (void)
{
    SFRPAGE = 0x00;
    ADEN = 0;

    ADC0CN1 =
    (0x2 << 6) |
    (0x0 << 3) |
    (0x0 << 0);

    ADC0CF0 =
    ((SYSCLK/SARCLK) << 3) |
    (0x0 << 2);

    ADC0CF1 =
    (0 << 7) |
    (0x1E << 0);

    ADC0CN0 =
    (0x0 << 7) |
    (0x0 << 6) |
    (0x0 << 5) |
    (0x0 << 4) |
    (0x0 << 3) |
    (0x0 << 2) |
    (0x0 << 0);

    ADC0CF2 =
    (0x0 << 7) |
    (0x1 << 5) |
    (0x1F << 0);

    ADC0CN2 =
    (0x0 << 7) |
    (0x0 << 0);

    ADEN = 1;
}

void InitPinADC (unsigned char portno, unsigned char pin_num)
{
    unsigned char mask;
    mask = 1 << pin_num;

    SFRPAGE = 0x20;
    switch (portno)
    {
        case 0:
            P0MDIN &= (~mask);
            P0SKIP |= mask;
            break;
        case 1:
            P1MDIN &= (~mask);
            P1SKIP |= mask;
            break;
        case 2:
            P2MDIN &= (~mask);
            P2SKIP |= mask;
            break;
        default:
            break;
    }
    SFRPAGE = 0x00;
}

unsigned int ADC_at_Pin(unsigned char pin)
{
    ADC0MX = pin;
    ADINT = 0;
    ADBUSY = 1;
    while (!ADINT);
    return ADC0;
}

int get_next_move(char path_flag, char intersection_count)
{
    if (path_flag == 1) return path_array1[intersection_count];
    else if (path_flag == 2) return path_array2[intersection_count];
    else return path_array3[intersection_count];
}

unsigned int left_inductor_reading;
unsigned int right_inductor_reading;
unsigned int intersection_inductor;

char at_intersection = 0;
char intersection_count = 0;
unsigned char clear_count = 0;
unsigned char intersection_move = 0;

void autonomous_mode(char path_flag)
{
    char path_length;
    int threshold = 200;

    if (path_flag == 1) path_length = sizeof(path_array1) / sizeof(path_array1[0]) - 1;
    else if (path_flag == 2) path_length = sizeof(path_array2) / sizeof(path_array2[0]) - 1;
    else path_length = sizeof(path_array3) / sizeof(path_array3[0]) - 1;

    left_inductor_reading = ADC_at_Pin(left_inductor);
    right_inductor_reading = ADC_at_Pin(right_inductor);
    intersection_inductor = ADC_at_Pin(middle_inductor);

    if (intersection_count >= path_length)
    {
        move_state = 0;
        movement_fsm();
        return;
    }

    if (at_intersection)
    {
        move_state = intersection_move;

        if (intersection_inductor < intersection_value)
        {
            clear_count++;
            if (clear_count >= 5)
            {
                at_intersection = 0;
                clear_count = 0;
            }
        }
        else
        {
            clear_count = 0;
        }

        movement_fsm();
        return;
    }

    if (right_inductor_reading > left_inductor_reading + threshold)
    {
        move_state = 5;
    }
    else if (left_inductor_reading > right_inductor_reading + threshold)
    {
        move_state = 4;
    }
    else
    {
        move_state = 1;
    }

    if (intersection_inductor >= intersection_value)
    {
        at_intersection = 1;
        clear_count = 0;

        intersection_move = get_next_move(path_flag, intersection_count);
        move_state = intersection_move;

        intersection_count++;

        if( move_state != 1)
        {
            movement_fsm();
            waitms(700);
        }

        move_state = 1;
        movement_fsm();

        waitms(350);
        return;
    }

    movement_fsm();
}

// ---------------- IR CODE ----------------

unsigned long measure_duration(bit target_state)
{
    unsigned long count = 0;

    while (IR_PIN == target_state)
    {
        count++;
        if (count > 400000UL) break;
    }

    return count;
}

bit approx_equal(unsigned long a, unsigned long b, unsigned long tol)
{
    if (a > b) return ((a - b) <= tol);
    else       return ((b - a) <= tol);
}

bit read_one_byte(unsigned char *value, unsigned long bit_diff_min)
{
    unsigned char i;
    unsigned long on_time, off_time;
    unsigned char temp = 0;

    for (i = 0; i < 8; i++)
    {
        unsigned long timeout = 0;

        while (IR_PIN != 0)
        {
            timeout++;
            if (timeout > 400000UL) return 0;
        }

        on_time = measure_duration(0);
        off_time = measure_duration(1);

        if (on_time > 390000UL || off_time > 390000UL)
        {
            return 0;
        }

        if ((on_time > off_time) && ((on_time - off_time) > bit_diff_min))
        {
            temp = (temp << 1) | 1;
        }
        else if ((off_time > on_time) && ((off_time - on_time) > bit_diff_min))
        {
            temp = (temp << 1);
        }
        else
        {
            return 0;
        }
    }

    *value = temp;
    return 1;
}

void decode_and_print(unsigned char hex_data)
{
    printf("Received HEX: 0x%02X -> ", (unsigned int)hex_data);

    switch (hex_data)
    {
        case 0x01: printf("STOP\r\n"); break;
        case 0x02: printf("FORWARD\r\n"); break;
        case 0x03: printf("BACKWARD\r\n"); break;
        case 0x04: printf("LEFT\r\n"); break;
        case 0x05: printf("RIGHT\r\n"); break;
        case 0x06: printf("ROTATE\r\n"); break;
        case 0x07: printf("SLIGHT RIGHT\r\n"); break;
        case 0x08: printf("SLIGHT LEFT\r\n"); break;
        case 0x09: printf("SLIGHT BACK RIGHT\r\n"); break;
        case 0x0A: printf("SLIGHT BACK LEFT\r\n"); break;
        case 0x0B: printf("PATH 1\r\n"); break;
        case 0x0C: printf("PATH 2\r\n"); break;
        case 0x0D: printf("PATH 3\r\n"); break;
        case 0x0E: printf("CRUISE\r\n"); break;
        default:   printf("UNKNOWN\r\n"); break;
    }
}

bit get_ir_command(unsigned char *cmd_byte)
{
    unsigned long on_time, off_time;
    unsigned char start_byte, end_byte;
    unsigned long start_min = 10000UL;
    unsigned long start_tol = 3000UL;
    unsigned long bit_diff_min = 800UL;

    bit oldEA;
    unsigned char oldSFRPAGE;
    bit oldTR5;

    if (IR_PIN != 0)
    {
        return 0;
    }

    oldEA = EA;
    EA = 0;

    oldSFRPAGE = SFRPAGE;
    SFRPAGE = 0x10;
    oldTR5 = TR5;
    TR5 = 0;
    SFRPAGE = oldSFRPAGE;

    on_time = measure_duration(0);
    off_time = measure_duration(1);

    if (on_time > 390000UL || off_time > 390000UL)
    {
        SFRPAGE = 0x10;
        TR5 = oldTR5;
        SFRPAGE = oldSFRPAGE;
        EA = oldEA;
        return 0;
    }

    if ((on_time > start_min) &&
        (off_time > start_min) &&
        approx_equal(on_time, off_time, start_tol))
    {
        if (!read_one_byte(&start_byte, bit_diff_min))
        {
            SFRPAGE = 0x10;
            TR5 = oldTR5;
            SFRPAGE = oldSFRPAGE;
            EA = oldEA;
            return 0;
        }

        if (!read_one_byte(cmd_byte, bit_diff_min))
        {
            SFRPAGE = 0x10;
            TR5 = oldTR5;
            SFRPAGE = oldSFRPAGE;
            EA = oldEA;
            return 0;
        }

        if (!read_one_byte(&end_byte, bit_diff_min))
        {
            SFRPAGE = 0x10;
            TR5 = oldTR5;
            SFRPAGE = oldSFRPAGE;
            EA = oldEA;
            return 0;
        }

        SFRPAGE = 0x10;
        TR5 = oldTR5;
        SFRPAGE = oldSFRPAGE;
        EA = oldEA;

        if (start_byte != 0x22) return 0;
        if (end_byte != 0x44)   return 0;

        return 1;
    }

    SFRPAGE = 0x10;
    TR5 = oldTR5;
    SFRPAGE = oldSFRPAGE;
    EA = oldEA;

    return 0;
}

void cruise_control_mode(void)
{
    uint16_t current_distance;
    xdata int error;
    xdata float derivative;
    xdata float control_output;
    xdata int motor_speed;
    xdata int base_speed_val;

    base_speed_val = 40;

    if(vl53l0x_read_range_single(&current_distance))
    {
        error = current_distance - target_distance;

        integral += error;

        if(integral > 1000) integral = 1000;
        if(integral < -1000) integral = -1000;

        derivative = (float)(error - last_error);
        last_error = error;

        control_output = (kp * error) + (ki * integral) + (kd * derivative);

        motor_speed = base_speed + (int)control_output;

        if(motor_speed > 50) motor_speed = 50;
        if(motor_speed < 0) motor_speed = 0;

        left_pwm_threshold = motor_speed;
        right_pwm_threshold = motor_speed;
        if(motor_speed > 0) move_state = 7;
    }
}

void main (void)
{
    unsigned xdata char rx_cmd;
    unsigned int voltage_val;
    int success;

    int distance_following_flag;
    uint16_t range;
    uint16_t distance_threshold;
    pwm_count = 0;
    pwm_threshold = 45;
    move_state = 0;
    range = 65535;
    //Timer3us_Init();
    Timer4ms_Init();
    waitms(1000);
    distance_threshold = 100;
    distance_following_flag = 1;

    InitADC();
    InitPinADC(1, 1);
    InitPinADC(0, 2);
    InitPinADC(2, 5);

    InitPinADC(1,5);
    success = vl53l0x_init();

    waitms(1000);
    path_flag = 1;

    while (1)
    {
        voltage_val = ADC_at_Pin(voltage_pin);

        if(voltage_val > 1000)
        {
            led_1 = 1;
            led_2 = 1;
            led_3 = 1;
        }
        else if(voltage_val > 700)
        {
            led_1 = 1;
            led_2 = 1;
            led_3 = 0;
        }
        else if(voltage_val > 300)
        {
            led_1 = 1;
            led_2 = 0;
            led_3 = 0;
        }
        else
        {
            led_1 = 0;
            led_2 = 0;
            led_3 = 0;
        }

        if (get_ir_command(&rx_cmd))
        {
            decode_and_print(rx_cmd);

            if (rx_cmd == 0x0B)
            {
                path_flag = 1;
                manual_mode = 0;
            }
            else if (rx_cmd == 0x0C)
            {
                path_flag = 2;
                manual_mode = 0;
            }
            else if (rx_cmd == 0x0D)
            {
                path_flag = 3;
                manual_mode = 0;
            }
            else if (rx_cmd == 0x0E)
            {
                manual_mode = 0;
                path_flag = 0;
                cruise_control_mode();
                movement_fsm();
            }
            else
            {
                manual_mode = 1;
                path_flag = 0;
                controller_mode(rx_cmd);

                if( rx_cmd == 0x06)
                {
                    move_state = 0;
                    movement_fsm();
                }
            }
        }

        if (path_flag != 0)
        {
            if(vl53l0x_read_range_single(&range))
            {
                if(range < distance_threshold)
                {
                    move_state = 0;
                    movement_fsm();
                    continue;
                }
            }

            autonomous_mode(path_flag);
        }

        /*
        if(distance_following_flag == 1)
        {
            cruise_control_mode();
            movement_fsm();
        }
        */
    }
}
