{
    unsigned int i, j;

    for(i = 0; i < ms; i++)
    {
        for(j = 0; j < 1000; j++);
    }
}



	void movement_fsm()
	{
		// we allready have the direction we want to move stored in the varible move_state
		if (move_state == 1)
		{//forwards
			left_pwm_threshold = base_speed;
			right_pwm_threshold = base_speed;
		}
		else if (move_state == 2)
