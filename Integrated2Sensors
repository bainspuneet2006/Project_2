unsigned char read_ir_pin(unsigned char sensor)
{
    if(sensor == 1) return IR_PIN1;
    return IR_PIN2;
}

//measure the pulse widths from the IR
unsigned long measure_duration(unsigned char sensor, bit target_state)
{
    unsigned long count = 0;

    while (read_ir_pin(sensor) == target_state)
    {
        count++;
        if (count > 400000UL) break;
    }

    return count;
}

//verifies the start pulse pair to be roughly the same length
bit approx_equal(unsigned long a, unsigned long b, unsigned long tol)
{
    if (a > b) return ((a - b) <= tol);
    else       return ((b - a) <= tol);
}

//Converts one byte
bit read_one_byte(unsigned char sensor, unsigned char *value, unsigned long bit_diff_min)
{
    unsigned char i;
    unsigned long on_time, off_time;
    unsigned char temp = 0;

    for(i = 0; i < 8; i++)
    {
        unsigned long timeout = 0;

        while(read_ir_pin(sensor) != 0)
        {
            timeout++;
            if(timeout > 400000UL) return 0;
        }

        on_time = measure_duration(sensor, 0);
        off_time = measure_duration(sensor, 1);

        if (on_time > 390000UL || off_time > 390000UL)
        {
            return 0;
        }

        if ((on_time > off_time) && ((on_time - off_time) > bit_diff_min))
        {
            temp = (temp << 1) | 1;
        }
        else if ((off_time > on_time) && ((off_time - on_time) > bit_diff_min))
        {
            temp = (temp << 1);
        }
        else
        {
            return 0;
        }
    }

    *value = temp;
    return 1;
}


