	InitPinADC(2,5);

	printf("started \n");

	while(1)
	{
		unsigned char rx_cmd;
		unsigned char sensor_used;

		if(get_ir_command(&rx_cmd, &sensor_used))
		{
			printf("IR sensor %u: ", (unsigned int)sensor_used);
			decode_and_print(rx_cmd);

			if(rx_cmd == 0x0B)
			{
				path_flag = 1;
				manual_mode = 0;
			}
			else if(rx_cmd == 0x0C)
			{
				path_flag = 2;
				manual_mode = 0;
			}
			else if(rx_cmd == 0x0D)
			{
				path_flag = 3;
				manual_mode = 0;
			}
			else
			{
				manual_mode = 1;
				controller_mode(rx_cmd);
			}
		}

		if(!manual_mode)
		{
			autonomous_mode(path_flag);
		}
	}
