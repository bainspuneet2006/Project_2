        case 0x0D: printf("PATH 3 \r\n"); break;
        default:   printf("UNKNOWN\r\n"); break;
    }
}

// Decode from one specific sensor
bit get_ir_command_from_sensor(unsigned char sensor, unsigned char *cmd_byte)
{
    unsigned long on_time, off_time;
    unsigned char start_byte, end_byte;

    unsigned long start_min = 10000UL;
    unsigned long start_tol = 3000UL;
    unsigned long bit_diff_min = 800UL;

    if(read_ir_pin(sensor) != 0)
    {
        return 0;
    }

    on_time = measure_duration(sensor, 0);
    off_time = measure_duration(sensor, 1);

    if (on_time > 390000UL || off_time > 390000UL)
    {
        return 0;
    }

    if ((on_time > start_min) &&
        (off_time > start_min) &&
        approx_equal(on_time, off_time, start_tol))
    {
        if(!read_one_byte(sensor, &start_byte, bit_diff_min)) return 0;
        if(!read_one_byte(sensor, cmd_byte, bit_diff_min))    return 0;
        if(!read_one_byte(sensor, &end_byte, bit_diff_min))   return 0;

        if(start_byte != 0x22) return 0;
        if(end_byte   != 0x44) return 0;

        return 1;
    }

    return 0;
}

// Try either sensor
bit get_ir_command(unsigned char *cmd_byte, unsigned char *sensor_used)
{
    if(read_ir_pin(1) == 0)
    {
        if(get_ir_command_from_sensor(1, cmd_byte))
        {
            *sensor_used = 1;
            return 1;
        }
    }

    if(read_ir_pin(2) == 0)
    {
        if(get_ir_command_from_sensor(2, cmd_byte))
        {
            *sensor_used = 2;
            return 1;
        }
    }

    return 0;
}


