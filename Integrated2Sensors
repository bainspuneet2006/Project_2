void autonomous_mode(int path_flag){

// intersection path
//CHANGE THRESHOLD VALUE Accordingly
  
//start off at zero as we will start at an intersection
//static int intersection_count;  
int path_length; 
int sensor_offset = 1000;





int threshold = 50;
//define threshold change if needed
if(path_flag == 1) path_length = sizeof(path_array1) / sizeof(path_array1[0]); 
else if(path_flag == 2) path_length = sizeof(path_array2) / sizeof(path_array2[0]); 
else path_length  = sizeof(path_array3) / sizeof(path_array3[0]);



left_inductor_reading = ADC_at_Pin(left_inductor); 
printf("Left inductor reading: %4u ", left_inductor_reading);
right_inductor_reading = ADC_at_Pin(right_inductor); 
printf(" Right inductor reading: %4u \n", right_inductor_reading);




if(intersection_count >= path_length){
	move_state = 0; 
	return; 
}
if(right_inductor_reading  > left_inductor_reading + threshold ){
	//move left to account for it 
	move_state = 5;
}
else if (left_inductor_reading > right_inductor_reading + threshold){
	// go right to account for it 
	move_state = 4; 
}
else{
	//keep going straight 
	move_state = 1; 

}


intersection_inductor = ADC_at_Pin(middle_inductor);
//printf("We keep going fr: Move_state: %d\n", move_state); 
//printf(" middle inductor %4u \n", intersection_inductor);
//check intersection value to find value needed for it to be an intersection

//found intersection
// we need to find a way to not saturate the intersection count but also do the full turn
// 
// AFTER (fixed) — execute the turn, wait for it to complete, then go forward
if(intersection_inductor >= intersection_value && !at_intersection){
    if(!stopped){
        move_state = 0;
        movement_fsm();
        waitms(300);           // Brief pause before the turn
        stopped = 1;
        return;
    }
    at_intersection = 1;
    stopped = 0;

    move_state = get_next_move(path_flag, intersection_count);
    intersection_count++;

    if(move_state == 0){       // End of path sentinel
        movement_fsm();
        return;
    }

    movement_fsm();            // Execute the turn
    waitms(600);               // Hold the turn long enough to complete it

    move_state = 1;            // NOW resume forward
    movement_fsm();
}
else if (intersection_inductor < intersection_value){

	at_intersection = 0;
	
	
}




movement_fsm();

}

