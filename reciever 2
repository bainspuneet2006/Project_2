#include <EFM8LB1.h>
#include <stdio.h>

#define SYSCLK 72000000L
#define BAUDRATE 115200L

#define IR_PIN P2_0   // TSOP output, active low

char _c51_external_startup (void)
{
    SFRPAGE = 0x00;
    WDTCN = 0xDE;
    WDTCN = 0xAD;

    VDM0CN = 0x80;
    RSTSRC = 0x02 | 0x04;

    SFRPAGE = 0x10;
    PFE0CN = 0x20;
    SFRPAGE = 0x00;

    CLKSEL = 0x00;
    CLKSEL = 0x00;
    while ((CLKSEL & 0x80) == 0);
    CLKSEL = 0x03;
    CLKSEL = 0x03;
    while ((CLKSEL & 0x80) == 0);

    SCON0 = 0x10;
    TH1 = 0x100 - ((SYSCLK / BAUDRATE) / (12L * 2L));
    TL1 = TH1;
    TMOD &= ~0xF0;
    TMOD |= 0x20;
    TR1 = 1;
    TI = 1;

    P0MDOUT |= 0x10;
    XBR0 = 0x01;
    XBR1 = 0x00;
    XBR2 = 0x40;

    P2MDOUT &= ~(0x01); // P2.0 input

    return 0;
}

unsigned long measure_duration(bit target_state)
{
    unsigned long count = 0;

    while (IR_PIN == target_state)
    {
        count++;
        if (count > 400000UL) break;
    }

    return count;
}

bit approx_equal(unsigned long a, unsigned long b, unsigned long tol)
{
    if (a > b) return ((a - b) <= tol);
    else       return ((b - a) <= tol);
}

void decode_and_print(unsigned char hex_data)
{
    printf("Received HEX: 0x%02X -> ", (unsigned int)hex_data);

    switch(hex_data)
    {
        case 0x01: printf("STOP\r\n"); break;
        case 0x02: printf("FORWARD\r\n"); break;
        case 0x03: printf("BACKWARD\r\n"); break;
        case 0x04: printf("LEFT\r\n"); break;
        case 0x05: printf("RIGHT\r\n"); break;
        case 0x06: printf("ROTATE\r\n"); break;
        default:   printf("UNKNOWN\r\n"); break;
    }
}

bit read_one_byte(unsigned char *value, unsigned long bit_diff_min)
{
    unsigned char i;
    unsigned long on_time, off_time;
    unsigned char temp = 0;
    unsigned long timeout;

    for(i = 0; i < 8; i++)
    {
        timeout = 0;
        while(IR_PIN != 0)
        {
            timeout++;
            if(timeout > 400000UL)
            {
                printf("Waited too long for next bit\r\n");
                return 0;
            }
        }

        on_time = measure_duration(0);
        off_time = measure_duration(1);

        printf("Bit %u: ON=%lu OFF=%lu\r\n", (unsigned int)i, on_time, off_time);

        if (on_time > 390000UL || off_time > 390000UL)
        {
            printf("Timeout during byte read\r\n");
            return 0;
        }

        if ((on_time > off_time) && ((on_time - off_time) > bit_diff_min))
        {
            temp = (temp << 1) | 1;
        }
        else if ((off_time > on_time) && ((off_time - on_time) > bit_diff_min))
        {
            temp = (temp << 1);
        }
        else
        {
            printf("Bad bit timing ON=%lu OFF=%lu\r\n", on_time, off_time);
            return 0;
        }
    }

    *value = temp;
    return 1;
}

void main(void)
{
    unsigned long on_time, off_time;
    unsigned char start_byte, cmd_byte, end_byte;

    unsigned long start_min = 3000UL;
    unsigned long start_tol = 6000UL;
    unsigned long bit_diff_min = 200UL;

    printf("\r\n===========================\r\n");
    printf(" IR Decoder Start/End V1   \r\n");
    printf("===========================\r\n");
    printf("Waiting for remote...\r\n");

    while(1)
    {
        if(IR_PIN == 0)
        {
            on_time = measure_duration(0);
            off_time = measure_duration(1);

            if (on_time > 390000UL || off_time > 390000UL)
            {
                continue;
            }

            printf("Leader ON=%lu OFF=%lu\r\n", on_time, off_time);

            if ((on_time > start_min) &&
                (off_time > start_min) &&
                approx_equal(on_time, off_time, start_tol))
            {
                printf("\r\nStart detected\r\n");

                if(!read_one_byte(&start_byte, bit_diff_min))
                {
                    printf("Failed reading start byte\r\n");
                    continue;
                }

                printf("Start byte = 0x%02X\r\n", (unsigned int)start_byte);

                if(start_byte != 0x22)
                {
                    printf("Invalid start byte\r\n");
                    continue;
                }

                if(!read_one_byte(&cmd_byte, bit_diff_min))
                {
                    printf("Failed reading command byte\r\n");
                    continue;
                }

                printf("Command byte = 0x%02X\r\n", (unsigned int)cmd_byte);

                if(!read_one_byte(&end_byte, bit_diff_min))
                {
                    printf("Failed reading end byte\r\n");
                    continue;
                }

                printf("End byte = 0x%02X\r\n", (unsigned int)end_byte);

                if(end_byte != 0x44)
                {
                    printf("Invalid end byte\r\n");
                    continue;
                }

                decode_and_print(cmd_byte);
            }
        }
    }
}
