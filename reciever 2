#include <EFM8LB1.h>
#include <stdio.h>

#define SYSCLK 72000000L
#define BAUDRATE 115200L

#define IR_PIN P2_0   // TSOP output, active low

char _c51_external_startup (void)
{
    SFRPAGE = 0x00;
    WDTCN = 0xDE;
    WDTCN = 0xAD;

    VDM0CN = 0x80;
    RSTSRC = 0x02 | 0x04;

    SFRPAGE = 0x10;
    PFE0CN = 0x20;
    SFRPAGE = 0x00;

    CLKSEL = 0x00;
    CLKSEL = 0x00;
    while ((CLKSEL & 0x80) == 0);
    CLKSEL = 0x03;
    CLKSEL = 0x03;
    while ((CLKSEL & 0x80) == 0);

    SCON0 = 0x10;
    TH1 = 0x100 - ((SYSCLK / BAUDRATE) / (12L * 2L));
    TL1 = TH1;
    TMOD &= ~0xF0;
    TMOD |= 0x20;
    TR1 = 1;
    TI = 1;

    P0MDOUT |= 0x10;
    XBR0 = 0x01;
    XBR1 = 0x00;
    XBR2 = 0x40;

    P2MDOUT &= ~(0x01); // P2.0 input

    return 0;
}

unsigned long measure_duration(bit state)
{
    unsigned long count = 0;

    while(IR_PIN == state)
    {
        count++;
        if(count > 400000UL) break;
    }

    return count;
}

bit approx_equal(unsigned long a, unsigned long b, unsigned long tol)
{
    if(a > b) return ((a - b) <= tol);
    else      return ((b - a) <= tol);
}

void print_command(unsigned char cmd)
{
    switch(cmd)
    {
        case 0x01: printf("STOP\r\n"); break;
        case 0x02: printf("FORWARD\r\n"); break;
        case 0x03: printf("BACKWARD\r\n"); break;
        case 0x04: printf("LEFT\r\n"); break;
        case 0x05: printf("RIGHT\r\n"); break;
        case 0x06: printf("ROTATE\r\n"); break;
        default:   printf("UNKNOWN\r\n"); break;
    }
}

bit read_byte(unsigned char *value, unsigned long diff_min)
{
    unsigned char i;
    unsigned long on_time, off_time;
    unsigned char temp = 0;

    for(i = 0; i < 8; i++)
    {
        // wait for LOW (start of bit)
        while(IR_PIN != 0);

        on_time  = measure_duration(0);
        off_time = measure_duration(1);

        if(on_time > 390000UL || off_time > 390000UL)
            return 0;

        if((on_time > off_time) && ((on_time - off_time) > diff_min))
        {
            temp = (temp << 1) | 1;
        }
        else if((off_time > on_time) && ((off_time - on_time) > diff_min))
        {
            temp = (temp << 1);
        }
        else
        {
            return 0;
        }
    }

    *value = temp;
    return 1;
}

void main(void)
{
    unsigned long on_time, off_time;
    unsigned char start_byte, cmd_byte, end_byte;

    // LOOSER thresholds (important)
    unsigned long start_min = 3000UL;
    unsigned long start_tol = 6000UL;
    unsigned long bit_diff_min = 200UL;

    printf("IR Ready\r\n");

    while(1)
    {
        if(IR_PIN == 0)
        {
            on_time  = measure_duration(0);
            off_time = measure_duration(1);

            if(on_time > 390000UL || off_time > 390000UL)
                continue;

            // detect start (5ms ON / 5ms OFF approx)
            if((on_time > start_min) &&
               (off_time > start_min) &&
               approx_equal(on_time, off_time, start_tol))
            {
                if(!read_byte(&start_byte, bit_diff_min)) continue;
                if(start_byte != 0x22) continue;

                if(!read_byte(&cmd_byte, bit_diff_min)) continue;
                if(!read_byte(&end_byte, bit_diff_min)) continue;
                if(end_byte != 0x44) continue;

                print_command(cmd_byte);
            }
        }
    }
}
