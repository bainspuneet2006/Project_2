#include <EFM8LB1.h>
#include <stdio.h>

#define SYSCLK     72000000L
#define BAUDRATE   115200L

#define IR_PIN P2_5   // TSOP output, active low

char _c51_external_startup (void)
{
    SFRPAGE = 0x00;
    WDTCN = 0xDE;
    WDTCN = 0xAD;

    VDM0CN = 0x80;
    RSTSRC = 0x02 | 0x04;

    SFRPAGE = 0x10;
    PFE0CN = 0x20;
    SFRPAGE = 0x00;

    CLKSEL = 0x00;
    CLKSEL = 0x00;
    while ((CLKSEL & 0x80) == 0);
    CLKSEL = 0x03;
    CLKSEL = 0x03;
    while ((CLKSEL & 0x80) == 0);

    SCON0 = 0x10;
    TH1 = 0x100 - ((SYSCLK / BAUDRATE) / (12L * 2L));
    TL1 = TH1;
    TMOD &= ~0xF0;
    TMOD |= 0x20;
    TR1 = 1;
    TI = 1;

    P0MDOUT |= 0x10;   // UART TX on P0.4
    XBR0 = 0x01;
    XBR1 = 0x00;
    XBR2 = 0x40;

    P2MDOUT &= ~(0x20); // P2.5 input

    return 0;
}

unsigned long measure_duration(bit target_state)
{
    unsigned long count = 0;

    while (IR_PIN == target_state)
    {
        count++;
        if (count > 400000UL) break;
    }

    return count;
}

bit approx_equal(unsigned long a, unsigned long b, unsigned long tol)
{
    if (a > b) return ((a - b) <= tol);
    else       return ((b - a) <= tol);
}

void decode_and_print(unsigned char hex_data)
{
    printf("RX HEX: 0x%02X -> ", (unsigned int)hex_data);

    switch(hex_data)
    {
        case 0x01: printf("STOP\r\n"); break;
        case 0x02: printf("FORWARD\r\n"); break;
        case 0x03: printf("BACKWARD\r\n"); break;
        case 0x04: printf("LEFT\r\n"); break;
        case 0x05: printf("RIGHT\r\n"); break;
        case 0x06: printf("ROTATE\r\n"); break;
        case 0x07: printf("SLIGHT_RIGHT\r\n"); break;
        case 0x08: printf("SLIGHT_LEFT\r\n"); break;
        case 0x09: printf("SLIGHT_BACK_RIGHT\r\n"); break;
        case 0x0A: printf("SLIGHT_BACK_LEFT\r\n"); break;
        case 0x0B: printf("PATH1\r\n"); break;
        case 0x0C: printf("PATH2\r\n"); break;
        case 0x0D: printf("PATH3\r\n"); break;
        default:   printf("UNKNOWN\r\n"); break;
    }
}

bit read_one_byte(unsigned char *value)
{
    unsigned char i;
    unsigned long on_time, off_time;
    unsigned char temp = 0;

    for(i = 0; i < 8; i++)
    {
        while(IR_PIN != 0);

        on_time = measure_duration(0);
        off_time = measure_duration(1);

        if (on_time > 390000UL || off_time > 390000UL)
        {
            return 0;
        }

        // 0 = 2ms ON + 2ms OFF
        // 1 = 2ms ON + 6ms OFF
        if (off_time > (on_time * 2))
        {
            temp = (temp << 1) | 1;
        }
        else
        {
            temp = (temp << 1);
        }
    }

    *value = temp;
    return 1;
}

bit read_frame(unsigned char *cmd)
{
    unsigned char rx_cmd, rx_inv;

    if (!read_one_byte(&rx_cmd)) return 0;
    if (!read_one_byte(&rx_inv)) return 0;

    if ((unsigned char)(rx_cmd ^ rx_inv) != 0xFF)
    {
        printf("Bad frame: CMD=0x%02X INV=0x%02X\r\n",
               (unsigned int)rx_cmd,
               (unsigned int)rx_inv);
        return 0;
    }

    *cmd = rx_cmd;
    return 1;
}

void main(void)
{
    unsigned long on_time, off_time;
    unsigned char cmd_byte;
    unsigned char last_cmd = 0x00;

    unsigned long leader_min = 10000UL;
    unsigned long leader_tol = 4000UL;

    printf("\r\n===========================\r\n");
    printf(" Robust IR Receiver Start  \r\n");
    printf("===========================\r\n");
    printf("Waiting for remote...\r\n");

    while(1)
    {
        if(IR_PIN == 0)
        {
            on_time = measure_duration(0);
            off_time = measure_duration(1);

            if (on_time > 390000UL || off_time > 390000UL)
            {
                continue;
            }

            if ((on_time > leader_min) &&
                (off_time > leader_min) &&
                approx_equal(on_time, off_time, leader_tol))
            {
                if (read_frame(&cmd_byte))
                {
                    if (cmd_byte != last_cmd)
                    {
                        decode_and_print(cmd_byte);
                        last_cmd = cmd_byte;
                    }
                }
            }
        }
    }
}
